            "url": { "raw": "{{baseUrl}}/api/bookings/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "user", "{{userId}}"] }
          }
        },
        {
          "name": "Cancel Booking (User)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
