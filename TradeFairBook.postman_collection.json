    {
      "name": "Aadhaar",
      "item": [
        {
          "name": "Submit Aadhaar (multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data._id) pm.collectionVariables.set('aadhaarVerificationId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "aadhaarName", "value": "Test User", "type": "text" },
                { "key": "aadhaarNumber", "value": "123412341234", "type": "text" },
                { "key": "aadhaarImage", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/aadhaar/submit", "host": ["{{baseUrl}}"], "path": ["api", "aadhaar", "submit"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data._id) pm.collectionVariables.set('bookingId', res.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stall\": \"{{stallId}}\",\n  \"aadhaarVerificationId\": \"{{aadhaarVerificationId}}\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/create", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "create"] }
          }
        },
